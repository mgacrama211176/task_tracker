generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  NOT_STARTED
  RUNNING
  PAUSED
  COMPLETED
}

model Task {
  id             String     @id @default(uuid())
  name           String
  description    String?
  status         TaskStatus @default(NOT_STARTED)
  startedAt      DateTime?
  pausedAt       DateTime?
  accumulatedMs  BigInt     @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([name])
}
