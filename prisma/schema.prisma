generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  DONE
}

model Task {
  id             String     @id @default(uuid())
  name           String
  description    String?
  status         TaskStatus @default(NOT_STARTED)
  startedAt      DateTime?
  pausedAt       DateTime?
  accumulatedMs  BigInt     @default(0)
  budgetMs       BigInt?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([name])
}
