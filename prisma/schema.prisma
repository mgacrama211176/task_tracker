generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  DONE
}

enum TaskType {
  TASK
  BUG
  ENHANCEMENT
  FEATURE
  BLOCKER
}

model Owner {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id             String     @id @default(uuid())
  name           String     @unique
  description    String?
  type           TaskType   @default(TASK)
  status         TaskStatus @default(NOT_STARTED)
  ownerId        String?
  owner          Owner?     @relation(fields: [ownerId], references: [id])
  startedAt      DateTime?
  pausedAt       DateTime?
  accumulatedMs  BigInt     @default(0)
  budgetMs       BigInt?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([name])
  @@index([ownerId])
}
